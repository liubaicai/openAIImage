PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
# Production: use HTTPS and set SECURE_COOKIES=true.
SECURE_COOKIES=false
# Set a persistent 64-character hexadecimal key in production.
# If omitted, a key is generated once in DATA_DIR/master.key.
# ENCRYPTION_KEY=
# Number of simultaneous model requests (1-8).
WORKER_CONCURRENCY=3
